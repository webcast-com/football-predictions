# Copy to .env.local and fill in values:  cp .env .env.local

# Postgres connection string. Local dev or Supabase
# (postgres://postgres:[pw]@db.[ref].supabase.co:5432/postgres — SSL auto-enabled)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: enables live Paystack payments + webhook verification.
# Without it, checkout runs in a safe built-in demo mode.
PAYSTACK_SECRET_KEY=

# Optional: Supabase Auth + Edge Function calls
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: canonical domain used in sitemap/OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
